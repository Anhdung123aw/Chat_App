{
  "info": {
    "name": "Chat App API",
    "description": "Phase 1 MVP API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Actuator",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "prometheus"]
            }
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Create Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('conversationId', response.conversationId);",
                  "    console.log('Conversation ID saved:', response.conversationId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user123\",\n  \"merchantId\": \"merchant001\",\n  \"topicCode\": \"ACCOUNT\",\n  \"context\": {\n    \"screenName\": \"ACCOUNT_MANAGEMENT\",\n    \"feature\": \"VIEW_BALANCE\",\n    \"lastAction\": \"TAP_SUPPORT\",\n    \"appVersion\": \"1.2.5\",\n    \"os\": \"Android\",\n    \"device\": \"Samsung Galaxy S23\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations"]
            }
          }
        },
        {
          "name": "Get Conversation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}"]
            }
          }
        },
        {
          "name": "List Conversations by User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations?userId=user123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations"],
              "query": [
                {
                  "key": "userId",
                  "value": "user123"
                }
              ]
            }
          }
        },
        {
          "name": "Get Queue (NEW conversations)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/queue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "queue"]
            }
          }
        },
        {
          "name": "Assign Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"agent001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "assign"]
            }
          }
        },
        {
          "name": "Transfer to Another Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAgentId\": \"agent002\",\n  \"transferredBy\": \"agent001\",\n  \"reason\": \"Specialist required\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "transfer"]
            }
          }
        },
        {
          "name": "Mark Messages as Read",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/read?upToSequence=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "read"],
              "query": [
                {
                  "key": "upToSequence",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Close Conversation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "close"]
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('messageId', response.messageId);",
                  "    console.log('Message ID saved:', response.messageId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"user123\",\n  \"senderType\": \"USER\",\n  \"messageType\": \"TEXT\",\n  \"content\": \"Xin chào, tôi cần hỗ trợ về tài khoản\",\n  \"clientMessageId\": \"client-msg-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "messages"]
            }
          }
        },
        {
          "name": "Send Agent Reply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"agent001\",\n  \"senderType\": \"AGENT\",\n  \"messageType\": \"TEXT\",\n  \"content\": \"Xin chào! Tôi có thể giúp gì cho bạn?\",\n  \"clientMessageId\": \"agent-msg-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "messages"]
            }
          }
        },
        {
          "name": "Get Message History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "messages"]
            }
          }
        },
        {
          "name": "Sync Messages After Sequence",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages?afterSequence=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "messages"],
              "query": [
                {
                  "key": "afterSequence",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Mark Single Message as Read",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages/{{messageId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "{{conversationId}}", "messages", "{{messageId}}", "read"]
            }
          }
        }
      ]
    },
    {
      "name": "Attachments",
      "item": [
        {
          "name": "Request Upload URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"fileName\": \"screenshot.png\",\n  \"contentType\": \"image/png\",\n  \"fileSize\": 524288\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attachments/upload-request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attachments", "upload-request"]
            }
          }
        },
        {
          "name": "Get Attachment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attachments/{attachmentId}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attachments", "{attachmentId}"]
            }
          }
        },
        {
          "name": "List Attachments by Message",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attachments?messageId={{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "attachments"],
              "query": [
                {
                  "key": "messageId",
                  "value": "{{messageId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
